# Cadastre estes valores somente no painel da Vercel. Nunca envie o arquivo real para o GitHub.
HOTMART_HOTTOK=cole_o_hottok_da_hotmart
FIREBASE_PROJECT_ID=engenharia-producao-musical
FIRESTORE_DATABASE_ID=default
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-exemplo@engenharia-producao-musical.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\ncole_a_chave_privada_aqui\\n-----END PRIVATE KEY-----\\n"

# Alternativa: em vez dos três campos FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL
# e FIREBASE_PRIVATE_KEY, você pode cadastrar somente FIREBASE_SERVICE_ACCOUNT_JSON
# com o JSON inteiro da conta de serviço do Firebase/Google Cloud em uma única linha.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"engenharia-producao-musical",...}
